# 1. reveal.js
# controls if reveal.js and its plugins are to be served locally
# N.B. doesn't affect publishing - CDN are always used in publishing mode
# USE_CDN_REVEALJS=false

# built-in plugins
ENABLE_HIGHLIGHT=true
ENABLE_MARKDOWN=true
ENABLE_MATH=true
ENABLE_NOTES=true
ENABLE_SEARCH=true
ENABLE_ZOOM=true

# third-party plugins
ENABLE_MENU=true
ENABLE_CHALKBOARD=true

# 2. misc options
# BUILD_CONCURRENCY=4

{
  "name": "ossec-slidev-lectures",
  "version": "0.1.0",
  "private": true,
  "description": "Portable multi-topic Slidev lecture collection",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "list": "node scripts/lectures.mjs list",
    "dev": "node scripts/lectures.mjs dev",
    "build": "node scripts/lectures.mjs build",
    "export": "node scripts/lectures.mjs export",
    "build:all": "node scripts/lectures.mjs build --all",
    "export:all": "node scripts/lectures.mjs export --all --format all",
    "setup:browser": "playwright install chromium"
  },
  "devDependencies": {
    "@slidev/cli": "^52.19.1",
    "@vue/compiler-sfc": "^3.5.42",
    "markdown-it-github-alerts": "^1.0.1",
    "playwright-chromium": "^1.58.0"
  }
}

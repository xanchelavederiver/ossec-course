{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slidev lecture catalog",
  "type": "object",
  "required": ["course", "topics"],
  "properties": {
    "course": { "type": "object", "required": ["title"] },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "lectures"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "lectures": { "type": "array" }
        }
      }
    }
  }
}
